# 复制为 .env 后填写（或在云平台控制台的「环境变量」里配置）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 通义千问（阿里云百炼 DashScope）
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus
# Gemini（大陆服务器无法直连，需海外部署或设置 GEMINI_BASE_URL 反代）
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# 其他 OpenAI 兼容接口
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
PORT=3000
