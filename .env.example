# 复制为 .env 后填写（或在云平台控制台的「环境变量」里配置）
# 不填 LLM_PROVIDER 时：有 MIMO_API_KEY 用 mimo，否则 deepseek
# 小米 MiMo（OpenAI 兼容，https://platform.xiaomimimo.com）
LLM_PROVIDER=mimo
MIMO_API_KEY=
# 也可以引用系统环境变量：MIMO_API_KEY=${MIMO_API_KEY}
MIMO_MODEL=mimo-v2.6-pro
# MIMO_THINKING=disabled   # enabled 开启深度思考（更慢）
# DeepSeek
# LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 通义千问（阿里云百炼 DashScope）
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus
# Gemini（大陆服务器无法直连，需海外部署或设置 GEMINI_BASE_URL 反代）
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# 其他 OpenAI 兼容接口
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
PORT=3000

# 接口保护
RATE_LIMIT_PER_MIN=8
RATE_LIMIT_PER_DAY=100
MAX_BODY_BYTES=65536
# 部署在反向代理后面时设为 1 以获取真实 IP
# TRUST_PROXY=1
