{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "lib": ["ES2022", "DOM"],
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "strict": true, "noImplicitAny": false, "strictNullChecks": false, "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true, "declaration": true, "sourceMap": false
  }
}
